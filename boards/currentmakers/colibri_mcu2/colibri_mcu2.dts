/dts-v1/;
#include <st/h5/stm32h562Xg.dtsi>
#include <st/h5/stm32h562rgtx-pinctrl.dtsi>
#include "./colibri_mcu2-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	model = "CurrentMakers MCU2";
	compatible = "currentmakers,mcu2";

	chosen {
		/* USART2 is your Debugger/Shell link */
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram1;
		zephyr,dtcm = &sram2;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		red_led: led_1 {
			gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};
	};

	aliases {
		led0 = &green_led;
		led1 = &red_led;
	};

	/* AUX pins for Carrier Board (Shield) */
	mcu_connector: mcu-slot-connector {
		compatible = "gpio-nexus";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffff>;
		gpio-map-pass-thru = <0 0>;
		gpio-map = <1 0 &gpiob 8 0>,  /* AUX1 */
				   <2 0 &gpiob 10 0>, /* AUX2 */
				   <3 0 &gpiob 12 0>, /* AUX3 */
				   <4 0 &gpiob 15 0>, /* AUX4 */
				   <5 0 &gpioa 15 0>; /* IO_RST */
	};

	slot_count: slot-count {
		compatible = "gpio-keys";
		/* Each pin must be a child node for this compatible */
		bit0: bit_0 { gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>; };
		bit1: bit_1 { gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>; };
		bit2: bit_2 { gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>; };
		bit3: bit_3 { gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>; };
		bit4: bit_4 { gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>; };
	};
};

/* Clock Configuration  */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <192>;
	div-p = <2>;
	div-q = <8>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(192)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

/*Trick the build system to recognize sram2 as DTCM for testing, remove when this is no longer needed */
&sram2 {
	compatible = "zephyr,memory-region", "mmio-sram";
    zephyr,memory-region = "DTCM";  
};

/* I2C1: Carrier Bus (configured here so the shield can extend it) */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

/* USART1: Reserved for Carrier Board (e.g., Modbus/RS-485) */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <19200>;
	status = "okay";
};

/* USART2: Dedicated for Debugging */
&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <921600>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";
	cs-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;

	w25q128_mcu: w25q128jv@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		size = <0x8000000>; /* 128Mbit */
		jedec-id = [ef 40 18];
		reset-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
		wp-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&timers3 {
	/*Now required since h562s rcc has TIMPRE bit that modifies the default timer behavior (if bus psc != 1 && TIMPRE (st, prescaler) == 0 then tims psc == 2 * psc (like on older chips), and if bus psc != 1 && TIMPRE (st, prescaler) == 1 then tims psc == 4 *  psc  )  */
	st,prescaler = <0>;
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pb5>;
		pinctrl-names = "default";
	};
};


/*device specific stuff*/

&gpdma1 {
	status = "okay";
};

/*This seems to change just the defines generated that affect the setup, still plugs into the same driver, pin names preserved for compat */

&usb {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};
